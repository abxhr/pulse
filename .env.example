# ---- Copy this file to .env and fill in your values ----

# ============ Hevy ============
# You do NOT need Hevy Pro. Pick a mode:
#   csv         -> import the free CSV export (reliable; drop files in backend/data/imports/
#                  or upload from the app). Also the fallback for the others.
#   unofficial  -> automated free sync via the unofficial private API (experimental).
#   pro         -> official public API (requires Hevy Pro + API key).
HEVY_MODE=csv

# -- unofficial mode: run `cd backend && python -m app.hevy_auth` ONCE (opens a
#    real browser, you log in there) — it saves tokens to backend/data/hevy_tokens.json
#    and auto-refreshes them after that. HEVY_EMAIL is just the key into that store,
#    whatever email you logged in with.
HEVY_EMAIL=
# Legacy fallback — paste tokens directly from hevy.com DevTools instead of the
# browser-login flow above. These don't auto-persist on refresh.
HEVY_ACCESS_TOKEN=
HEVY_REFRESH_TOKEN=

# -- pro mode only:
HEVY_API_KEY=

# ============ AI provider: "anthropic" or "openai" ============
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ============ Garmin ============
# Run `python -m app.auth_garmin` once (handles 2FA) to cache tokens. No password here.
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# ============ Scheduler (automated background sync) ============
ENABLE_SCHEDULER=true
SYNC_INTERVAL_MINUTES=30
QUICK_SYNC_DAYS=7
DEFAULT_BACKFILL_DAYS=1825

# ============ Server / self-hosting (Raspberry Pi) ============
HOST=0.0.0.0
PORT=8080
SERVE_FRONTEND=true

# ============ Overview extras ============
# Nightly sleep need used by the sleep-debt tracker.
SLEEP_TARGET_HOURS=8.0
# Set these to enable the weather card on the readiness panel (no API key needed).
LATITUDE=
LONGITUDE=
